package Project;

import java.io.Serializable;
import java.util.*;

public class AppData implements Serializable {
    private static final long serialVersionUID = 1L;

    // ArrayList: คลังคำศัพท์ทั้งหมด
    private final ArrayList<Word> words = new ArrayList<>();

    // HashMap: ค้นหาคำศัพท์จากคำภาษาอังกฤษได้รวดเร็ว
    private final HashMap<String, Word> wordMap = new HashMap<>();

    // TreeMap: จัดหมวดหมู่บทเรียนตามลำดับชื่อ (โครงสร้างต้นไม้แบบ Sorted Map)
    private final TreeMap<String, ArrayList<Word>> categories = new TreeMap<>();

    // Stack: เก็บประวัติคำศัพท์ที่เปิดเรียนล่าสุด
    private final Stack<Word> history = new Stack<>();

    // LinkedList: บันทึกกิจกรรมการเรียน
    private final LinkedList<String> activityLog = new LinkedList<>();

    // PriorityQueue: คำศัพท์ที่ต้องทบทวน โดยคำที่ผิดบ่อยจะมีลำดับก่อน
    private final PriorityQueue<ReviewItem> reviewQueue = new PriorityQueue<>();

    private int xp = 0;
    private int correctAnswers = 0;
    private int totalAnswers = 0;
    private int lessonsCompleted = 0;

    public AppData() {
        addWord(new Word("Greeting", "Hello", "สวัสดี", "heh low เฮอะ โลว"));
        addWord(new Word("Greeting", "Good morning", "อรุณสวัสดิ์", "gud mor nuhng กุ๊ด มอ นิ่ง"));
        addWord(new Word("Greeting", "Thank you", "ขอบคุณ", "thangk yoo แต๊ง คิว"));
        addWord(new Word("Greeting", "Goodbye", "ลาก่อน", "gud bai กุ๊ด บาย"));
        addWord(new Word("Greeting", "Please", "กรุณา", "pleez พลีส "));

        addWord(new Word("Food", "Apple", "แอปเปิล", "ap uhl แอป เพิล"));
        addWord(new Word("Food", "Bread", "ขนมปัง", "bred เบรด"));
        addWord(new Word("Food", "Water", "น้ำ", "waw ter วอ เทอร์"));
        addWord(new Word("Food", "Rice", "ข้าว", "rahys ไรซ์"));
        addWord(new Word("Food", "Milk", "นม", "milk มิลค์"));

        addWord(new Word("Animals", "Cat", "แมว", "kat แคท"));
        addWord(new Word("Animals", "Dog", "สุนัข", "dawg ดอก"));
        addWord(new Word("Animals", "Bird", "นก", "burd เบิร์ด"));
        addWord(new Word("Animals", "Rabbit", "กระต่าย", "rab it แร็บ บิท"));
        addWord(new Word("Animals", "Fish", "ปลา", "fish ฟิช"));

        addWord(new Word("Place", "School", "โรงเรียน", "skool สกูล"));
        addWord(new Word("Place", "Hospital", "โรงพยาบาล", "hos pi tl ฮอส พิ เทิล"));
        addWord(new Word("Place", "Library", "ห้องสมุด", "lahy brer ee ไล บรา รี"));
        addWord(new Word("Place", "Market", "ตลาด", "mar kit มาร์ เก็ต"));
        addWord(new Word("Place", "Airport", "สนามบิน", "air pawrt แอร์ พอร์ต"));
    }


    // เพิ่มคอร์สภาษาใหม่พร้อมคำศัพท์เริ่มต้น โดยเก็บลงโครงสร้างข้อมูลเดิม
    public boolean addLanguageCourse(String language) {
        if (language == null || language.trim().isEmpty()) return false;
        String key = language.trim();
        String category = key + " · Greeting";
        if (categories.containsKey(category)) return false;

        String[][] entries;
        switch (key) {
            case "日本語 (Japanese)":
                entries = new String[][] {
                        {"こんにちは", "สวัสดี", "kon-ni-chi-wa คอน-นิ-จิ-วะ"},
                        {"ありがとう", "ขอบคุณ", "a-ri-ga-tou อะ-ริ-กา-โต"},
                        {"さようなら", "ลาก่อน", "sa-you-na-ra ซา-โย-นา-ระ"},
                        {"おはよう", "อรุณสวัสดิ์", "o-ha-you โอะ-ฮา-โย"},
                        {"すみません", "ขอโทษ / ขออนุญาต", "su-mi-ma-sen ซุ-มิ-มา-เซ็น"}
                };
                break;

            case "한국어 (Korean)":
                entries = new String[][] {
                        {"안녕하세요", "สวัสดี", "an-nyeong-ha-se-yo อัน-นยอง-ฮา-เซ-โย"},
                        {"감사합니다", "ขอบคุณ", "gam-sa-ham-ni-da คัม-ซา-ฮัม-นี-ดา"},
                        {"안녕히 가세요", "ลาก่อน", "an-nyeong-hi-ga-se-yo อัน-นยอง-ฮี-กา-เซ-โย"},
                        {"좋은 아침", "อรุณสวัสดิ์", "jo-eun-a-chim โช-อึน-อา-ชิม"},
                        {"죄송합니다", "ขอโทษ", "joe-song-ham-ni-da ชเว-ซง-ฮัม-นี-ดา"}
                };
                break;

            case "中文 (Chinese)":
                entries = new String[][] {
                        {"你好", "สวัสดี", "ni hao หนี-ห่าว"},
                        {"谢谢", "ขอบคุณ", "xie xie เซี่ย-เซี่ย"},
                        {"再见", "ลาก่อน", "zai jian ไจ้-เจี้ยน"},
                        {"早上好", "อรุณสวัสดิ์", "zao shang hao เจ่า-ซ่าง-ห่าว"},
                        {"对不起", "ขอโทษ", "dui bu qi ตุ้ย-ปู้-ฉี่"}
                };
                break;

            case "Español (Spanish)":
                entries = new String[][] {
                        {"Hola", "สวัสดี", "o-la โอ-ลา"},
                        {"Gracias", "ขอบคุณ", "gra-thias กรา-เซียส"},
                        {"Adiós", "ลาก่อน", "a-dios อา-ดิออส"},
                        {"Buenos días", "อรุณสวัสดิ์", "bwe-nos di-as บเว-โนส ดี-อัส"},
                        {"Lo siento", "ขอโทษ", "lo syen-to โล-เซียน-โต"}
                };
                break;

            case "Français (French)":
                entries = new String[][] {
                        {"Bonjour", "สวัสดี", "bon-zhoor บง-ชูร์"},
                        {"Merci", "ขอบคุณ", "mehr-see แมร์-ซี"},
                        {"Au revoir", "ลาก่อน", "oh ruh-vwar โอ-เรอ-วัวร์"},
                        {"Bonsoir", "สวัสดีตอนเย็น", "bon-swahr บง-ซัวร์"},
                        {"Pardon", "ขอโทษ", "par-don ปาร์-ดง"}
                };
                break;

            case "Deutsch (German)":
                entries = new String[][] {
                        {"Hallo", "สวัสดี", "ha-lo ฮัล-โล"},
                        {"Danke", "ขอบคุณ", "dan-kuh ดัง-เคอะ"},
                        {"Auf Wiedersehen", "ลาก่อน", "owf vee-der-zay-en เอาฟ์-วี-เดอร์-เซ-เอิน"},
                        {"Guten Morgen", "อรุณสวัสดิ์", "goo-ten mor-gen กู-เทิน มอร์-เกิน"},
                        {"Entschuldigung", "ขอโทษ", "ent-shool-di-goong เอ็นท์-ชูล-ดิ-กุง"}
                };
                break;
            default:
                return false;
        }

        for (String[] entry : entries) {
            addWord(new Word(category, entry[0], entry[1], entry[2]));
        }
        log("Add course " + key);
        return true;
    }

    private void addWord(Word word) {
        words.add(word);
        wordMap.put(word.getEnglish().toLowerCase(Locale.ROOT), word);
        categories.computeIfAbsent(word.getCategory(), k -> new ArrayList<>()).add(word);
    }

    public ArrayList<Word> getWords() { return words; }
    public HashMap<String, Word> getWordMap() { return wordMap; }
    public TreeMap<String, ArrayList<Word>> getCategories() { return categories; }
    public Stack<Word> getHistory() { return history; }
    public LinkedList<String> getActivityLog() { return activityLog; }
    public PriorityQueue<ReviewItem> getReviewQueue() { return reviewQueue; }

    public int getXp() { return xp; }
    public int getCorrectAnswers() { return correctAnswers; }
    public int getTotalAnswers() { return totalAnswers; }
    public int getLessonsCompleted() { return lessonsCompleted; }

    public void recordAnswer(boolean correct) {
        totalAnswers++;
        if (correct) {
            correctAnswers++;
            xp += 10;
        }
    }

    public void addXp(int amount) { xp += amount; }
    public void lessonCompleted() { lessonsCompleted++; }

    public void log(String message) {
        activityLog.addFirst(message);
        while (activityLog.size() > 30) activityLog.removeLast();
    }

    public static class ReviewItem implements Serializable, Comparable<ReviewItem> {
        private static final long serialVersionUID = 1L;
        private final String english;
        private final int priority;
        public ReviewItem(String english, int priority) {
            this.english = english;
            this.priority = priority;
        }
        public String getEnglish() { return english; }
        public int getPriority() { return priority; }

        @Override
        public int compareTo(ReviewItem other) {
            return Integer.compare(this.priority, other.priority);
        }
    }
}
